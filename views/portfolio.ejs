<%- include('partials/head') %><%- include('partials/nav') %>
        <section class="page-hero">
            <p class="kicker">PORTFOLIO</p>
            <h1>Demo projects, made to inspire possibilities.</h1>
            <p>As a new studio, these concepts demonstrate the kind of polished, adaptable experiences we can create.
            </p>
        </section>
        <section class="section">
            <div class="project-grid full">
                <% projects.forEach((p,i)=>{%><article class="project">
                        <div class="project-art art-<%=i%3%>">
                            <%if(p.image){%><img src="<%=p.image%>" alt="<%=p.title%>" loading="lazy" decoding="async">
                                <%}else{%><span>Demo Project</span><b>
                                        <%=p.title%>
                                    </b>
                                    <%}%>
                        </div>
                        <div class="project-info"><small>DEMO PROJECT</small>
                            <h3>
                                <%=p.title%>
                            </h3>
                            <p>
                                <%=p.description%>
                            </p>
                            <div>
                                <%p.technologies.forEach(t=>{%><span class="tag">
                                        <%=t%>
                                    </span>
                                    <%})%>
                            </div>
                            <p class="project-links">
                                <%if(p.demoUrl){%><a href="<%=p.demoUrl%>" target="_blank">Live demo ↗</a>
                                    <%}%>
                                        <%if(p.githubUrl){%><a href="<%=p.githubUrl%>" target="_blank">GitHub ↗</a>
                                            <%}%>
                            </p>
                        </div>
                    </article>
                    <%})%>
            </div>
        </section><%- include('partials/footer') %>