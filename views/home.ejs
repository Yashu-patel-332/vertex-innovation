<%- include('partials/head') %><%- include('partials/nav') %>
        <section class="hero">
            <div class="orb orb-one"></div>
            <div class="eyebrow">Independent software studio</div>
            <h1>Digital products<br>built to <em>move</em> you forward.</h1>
            <p>Vertex Web crafts fast, secure and memorable websites and web applications for ambitious businesses and
                startups.</p>
            <div class="actions"><a class="btn primary" href="/contact">Start a project <span>→</span></a><a class="btn"
                    href="/portfolio">Explore our work</a></div>
            <div class="hero-note"><span class="pulse"></span> Available for select new projects <span class="type"
                    data-words="Websites|Web applications|Digital solutions"></span></div>
        </section>
        <section class="split reveal">
            <div>
                <p class="kicker">WHO WE ARE</p>
                <h2>Small team.<br>Serious digital craft.</h2>
            </div>
            <div>
                <p>We bring design thinking and disciplined engineering together to make web experiences that feel
                    effortless. Every project is shaped by your goals, your users and a focus on quality.</p><a
                    class="text-link" href="/about">Meet Vertex Web →</a>
            </div>
        </section>
        <section class="section">
            <div class="section-head">
                <div>
                    <p class="kicker">CAPABILITIES</p>
                    <h2>Designed to solve, built to last.</h2>
                </div><a class="text-link" href="/services">All services →</a>
            </div>
            <div class="card-grid services">
                <% services.forEach(service=>{ %><article class="card reveal"><span class="service-icon">◈</span>
                        <h3>
                            <%= service.title %>
                        </h3>
                        <p>
                            <%= service.description %>
                        </p><a href="/services">Learn more →</a>
                    </article>
                    <% }) %>
            </div>
        </section>
        <section class="band">
            <p class="kicker">OUR TOOLKIT</p>
            <div class="techs">
                <span>HTML5</span><span>CSS3</span><span>JavaScript</span><span>Node.js</span><span>Express</span><span>MongoDB</span><span>EJS</span><span>Git</span>
            </div>
        </section>
        <section class="section">
            <div class="section-head">
                <div>
                    <p class="kicker">DEMO PROJECTS</p>
                    <h2>Ideas brought to interface.</h2>
                </div><a class="text-link" href="/portfolio">View all demos →</a>
            </div>
            <div class="project-grid">
                <% projects.forEach((project,i)=>{ %><article class="project reveal">
                        <div class="project-art art-<%= i %>"><span>Demo Project</span><b>
                                <%= project.title %>
                            </b></div>
                        <div class="project-info"><small>DEMO PROJECT</small>
                            <h3>
                                <%= project.title %>
                            </h3>
                            <p>
                                <%= project.description %>
                            </p>
                            <div>
                                <% project.technologies.slice(0,3).forEach(t=>{ %><span class="tag">
                                        <%= t %>
                                    </span>
                                    <% }) %>
                            </div>
                        </div>
                    </article>
                    <% }) %>
            </div>
        </section>
        <section class="section process">
            <p class="kicker">HOW WE WORK</p>
            <h2>A clear path from idea to impact.</h2>
            <div class="steps">
                <div><b>01</b>
                    <h3>Discover</h3>
                    <p>We clarify goals, users, scope and the smartest way forward.</p>
                </div>
                <div><b>02</b>
                    <h3>Design & build</h3>
                    <p>We turn the plan into a polished, responsive digital product.</p>
                </div>
                <div><b>03</b>
                    <h3>Launch & refine</h3>
                    <p>We deploy carefully and help you keep improving after launch.</p>
                </div>
            </div>
        </section>
        <section class="team section">
            <div class="section-head">
                <div>
                    <p class="kicker">THE TEAM</p>
                    <h2>The people behind the pixels.</h2>
                </div>
            </div>

            <div class="team-grid">

                <% const members=[ [ 'Yashu Patel' , 'Full Stack Developer'
                    , 'Builds reliable, end-to-end web products with a practical eye for detail.' ,
                    ['HTML','CSS','JavaScript','Node.js','Express.js','MongoDB','EJS','Git','GitHub'] ],
                    [ 'Nisarg Patel' , 'Frontend Developer'
                    , 'Creates responsive interfaces that are clear, accessible and enjoyable to use.' ,
                    ['HTML','CSS','JavaScript','Responsive Design','UI Development'] ], [ 'Ankit Patel'
                    , 'Backend Developer'
                    , 'Engineers the robust services and APIs that power smooth digital experiences.' ,
                    ['Node.js','Express.js','MongoDB','REST API','Authentication'] ] ]; members.forEach(m=> {
                    %>

                    <article class="member reveal">

                        <div class="avatar">
                            <span>
                                <%= m[0].split(' ').map(x => x[0]).join('') %>
                </span>
            </div>

            <h3><%= m[0] %></h3>

            <small><%= m[1] %></small>

            <p><%= m[2] %></p>

            <div class="tags">
                <% m[3].forEach(x => { %>
                    <span><%= x %></span>
                <% }) %>
            </div>

            <div class="socials">
                <a href="" aria-label="GitHub">◉</a>
                <a href="" aria-label="LinkedIn">in</a>
            </div>

        </article>

        <% }) %>

    </div>
</section>
                   <section class="cta">
                        <p class="kicker">LET' S BUILD</p>
                                    <h2>Have a vision?<br>Let's give it momentum.</h2>
                                    <a class="btn primary" href="/contact">Tell us about it <span>→</span></a>

        </section><%- include('partials/footer') %>