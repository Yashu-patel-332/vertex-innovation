<%- include('partials') %><main class="admin-main"><div class="admin-title"><p class="kicker">CONTENT</p><h1>Manage services</h1></div><section class="admin-panel"><h2>Add service</h2><form class="admin-form" method="post"><input required name="title" placeholder="Service title"><input required name="icon" placeholder="Icon name (optional)" value="code"><input required type="number" name="order" placeholder="Display order" value="0"><textarea required name="description" placeholder="Description"></textarea><label class="check"><input type="checkbox" name="featured"> Feature on home page</label><button class="btn primary">Add service</button></form></section><section class="admin-panel"><h2>Existing services</h2><%items.forEach(x=>{%><form class="admin-form edit" action="/admin/services/<%=x._id%>" method="post"><input name="title" value="<%=x.title%>"><input name="icon" value="<%=x.icon%>"><input type="number" name="order" value="<%=x.order%>"><textarea name="description"><%=x.description%></textarea><label class="check"><input type="checkbox" name="featured" <%=x.featured?'checked':''%>> Featured</label><button>Save</button><button formaction="/admin/services/<%=x._id%>/delete" class="danger">Delete</button></form><%})%></section></main><link rel="stylesheet" href="/css/style.css">
