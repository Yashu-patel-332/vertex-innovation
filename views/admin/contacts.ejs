<%- include('partials') %><main class="admin-main"><div class="admin-title"><p class="kicker">INBOX</p><h1>Contact messages</h1></div><section class="admin-panel"><%if(!items.length){%><p>No messages yet.</p><%}%><%items.forEach(x=>{%><article class="message"><div><h3><%=x.subject%></h3><p><b><%=x.name%></b> · <a href="mailto:<%=x.email%>"><%=x.email%></a> <%=x.phone?'· '+x.phone:''%></p><p><%=x.message%></p></div><form action="/admin/contacts/<%=x._id%>" method="post"><select name="status"><%['new','read','replied'].forEach(s=>{%><option <%=x.status===s?'selected':''%>><%=s%></option><%})%></select><button>Update</button></form></article><%})%></section></main><link rel="stylesheet" href="/css/style.css">
