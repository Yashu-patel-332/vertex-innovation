<%- include('partials') %><main class="admin-main"><div class="admin-title"><p class="kicker">OVERVIEW</p><h1>Dashboard</h1></div><div class="stats"><div><b><%=counts.services%></b><span>Services</span></div><div><b><%=counts.projects%></b><span>Projects</span></div><div><b><%=counts.blogs%></b><span>Blog posts</span></div><div><b><%=counts.contacts%></b><span>Messages</span></div></div><section class="admin-panel"><h2>Recent messages</h2><%if(!recent.length){%><p>No messages yet.</p><%}else{%><table><tr><th>Name</th><th>Subject</th><th>Status</th><th>Received</th></tr><%recent.forEach(x=>{%><tr><td><%=x.name%></td><td><%=x.subject%></td><td><span class="status"><%=x.status%></span></td><td><%=new Date(x.createdAt).toLocaleDateString()%></td></tr><%})%></table><%}%></section></main><link rel="stylesheet" href="/css/style.css">
