<%- include('partials') %><main class="admin-main"><div class="admin-title"><p class="kicker">CONTENT</p><h1>Manage portfolio</h1></div><section class="admin-panel"><h2>Add demo project</h2><form class="admin-form" method="post" enctype="multipart/form-data"><input required name="title" placeholder="Project title"><input name="category" value="Demo Project"><input name="technologies" placeholder="HTML5, CSS3, JavaScript"><input name="demoUrl" placeholder="Live demo URL"><input name="githubUrl" placeholder="GitHub URL"><input type="file" name="image" accept="image/*"><textarea required name="description" placeholder="Description"></textarea><label class="check"><input type="checkbox" name="featured"> Feature on home page</label><button class="btn primary">Add project</button></form></section><section class="admin-panel"><h2>Existing projects</h2><%items.forEach(x=>{%><form class="admin-form edit" action="/admin/projects/<%=x._id%>" method="post" enctype="multipart/form-data"><input name="title" value="<%=x.title%>"><input name="category" value="<%=x.category%>"><input name="technologies" value="<%=x.technologies.join(', ')%>"><input name="demoUrl" value="<%=x.demoUrl%>"><input name="githubUrl" value="<%=x.githubUrl%>"><input type="file" name="image" accept="image/*"><textarea name="description"><%=x.description%></textarea><label class="check"><input type="checkbox" name="featured" <%=x.featured?'checked':''%>> Featured</label><button>Save</button><button formaction="/admin/projects/<%=x._id%>/delete" class="danger">Delete</button></form><%})%></section></main><link rel="stylesheet" href="/css/style.css">
